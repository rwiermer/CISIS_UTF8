{
  "name": "@abcd-community/cisis-wasm",
  "version": "0.1.0-dev",
  "description": "Worker-isolated browser runtime for CISIS MX and WXIS",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker.js": "./dist/worker.js"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','test-dist']) fs.rmSync(path,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test-dist/src/*.test.js",
    "test:browser": "playwright test --config test/browser/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
